rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAnonymousVisitor() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /shared/schedule {
      allow read: if isAnonymousVisitor();
      allow create, update: if isAnonymousVisitor()
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state is map
        && request.resource.data.state.keys().hasAll([
          'availabilities',
          'finalSchedule',
          'shiftQuotas',
          'staffPositions',
          'scheduleHistory',
          'scheduleDateRange'
        ])
        && request.resource.data.state.keys().hasOnly([
          'availabilities',
          'finalSchedule',
          'shiftQuotas',
          'staffPositions',
          'scheduleHistory',
          'scheduleDateRange'
        ]);
      allow delete: if false;
    }
  }
}
